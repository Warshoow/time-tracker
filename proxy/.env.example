# URL de base de ton instance Jira Cloud (sans slash final)
JIRA_BASE_URL=https://macompagnie.atlassian.net

# Email du compte Atlassian qui possède le token API
JIRA_EMAIL=toi@macompagnie.com

# API token créé sur https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=ATATT3xFfGF0...

# Origines autorisées (CORS). Plusieurs séparées par virgule.
# En prod : l'URL de ton frontend (GitHub Pages, ou ton domaine perso).
ALLOWED_ORIGIN=https://warshoow.github.io

# Port d'écoute (Dokploy mappera ce port via son reverse proxy)
PORT=3000
